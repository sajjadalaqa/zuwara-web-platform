# Server-only API configuration. Never prefix these with NEXT_PUBLIC_.
ZUWARA_API_BASE_URL=https://dashboard.zuwara.sa/api
ZUWARA_API_KEY=
D4H_API_BASE_URL=https://dashboardvisit.zuwara.sa/api

# Public canonical website origin.
NEXT_PUBLIC_SITE_URL=https://www.zuwara.sa

# Leave unset/false during development: the site is served noindex, nofollow.
# Set to true only when going live on the real domain.
SITE_INDEXABLE=false

# Zuwara Platform V2 (server-only; separate from legacy catalogue API).
ZUWARA_V2_API_BASE_URL=https://dashboard.zuwara.sa/api/platform/v2

# At least 32 random characters; set separately on every deployment. Server-only.
NEXT_SERVER_SESSION_SECRET=

# D4H Platform V2 provider and home-service endpoints (server-only).
D4H_V2_API_BASE_URL=https://dashboardvisit.zuwara.sa/api/platform/v2
