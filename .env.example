# Server-only API configuration. Never prefix these with NEXT_PUBLIC_.
ZUWARA_API_BASE_URL=https://dashboard.zuwara.sa/api
ZUWARA_API_KEY=
D4H_API_BASE_URL=https://dashboardvisit.zuwara.sa/api

# Public canonical website origin.
NEXT_PUBLIC_SITE_URL=https://www.zuwara.sa

# Leave unset/false during development: the site is served noindex, nofollow.
# Set to true only when going live on the real domain.
SITE_INDEXABLE=false
